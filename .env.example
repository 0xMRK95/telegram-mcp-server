# Copy to .env and fill in. NEVER commit the filled-in .env.
# Get these from https://my.telegram.org -> API Development Tools

# Numeric app id from my.telegram.org
TG_API_ID=

# 32-char app hash from my.telegram.org
TG_API_HASH=

# Path to the session file WITHOUT the .session suffix.
# Telethon will create <TG_SESSION_NAME>.session next to it on first login.
#   - that file IS your Telegram login. Back it up privately, never share it.
TG_SESSION_NAME=./session/my_account