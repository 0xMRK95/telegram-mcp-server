# Recommended: user-run onboarding.py creates a private file OUTSIDE this checkout.
# Only its path belongs here; never commit the actual configuration or sessions.
TG_ACCOUNTS_FILE=/absolute/private/path/accounts.json

# Legacy alternative: omit TG_ACCOUNTS_FILE and set all three below.
# TG_API_ID=
# TG_API_HASH=
# TG_SESSION_NAME=/absolute/private/path/my_account

# Safe default: read/list plus NEW folder creation only.
TG_MODE=organization
# Set general only for an explicitly authorized broader deployment.
